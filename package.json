{
  "name": "verdant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @verdant/client",
    "build": "npm run build -w @verdant/client",
    "preview": "npm run preview -w @verdant/client",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "npm run build && node tools/smoke.mjs",
    "build:single": "npm run build:single -w @verdant/client",
    "artifact": "npm run build:single && node tools/make-artifact.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "playwright": "^1.56.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.0"
  }
}
