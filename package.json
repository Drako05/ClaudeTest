{
  "name": "verdant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @verdant/client",
    "build": "npm run build -w @verdant/client",
    "preview": "npm run preview -w @verdant/client",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "npm run build && node tools/smoke.mjs",
    "shots": "npm run build && node tools/shots.mjs",
    "gestures": "npm run build && node tools/gestures.mjs",
    "slash": "npm run build && node tools/slash.mjs",
    "build:pages": "npm run build && node tools/build-pages.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "playwright": "^1.56.1",
    "typescript": "^5.6.0",
    "vite": "^8.3.5",
    "vite-node": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.5"
  }
}
